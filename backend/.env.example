DATABASE_URL=postgresql://user:password@localhost:5432/boletoya_db
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Password recovery: reset link validity in minutes
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP - Mailtrap Email Sandbox (Email Testing > Inboxes > your inbox > SMTP Settings)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_USE_TLS=true
MAIL_FROM_ADDRESS=no-reply@boletoya.local
MAIL_FROM_NAME=BoletoYa
